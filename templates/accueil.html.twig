{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <main>
        {% if sorties is defined %}
            {% if is_granted('ROLE_MONITEUR') %}
                <a href="{{ path('createSortie') }}">Ajouter une sortie</a>
            {% endif %}
            <h1>Les sorties à venir</h1>
            <ul>
                {% for sortie in sorties %}
                    <li>
                        <a href="{{ path('sortie', {'id': sortie.id}) }}">Sortie du type {{ sortie.type }} à {{ sortie.lieu }} le {{ sortie.dateSortie|date('d/m/Y') }} sur le crenaux : {{ sortie.creneau.value }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>Aucune sortie à venir</p>
        {% endif %}
    </main>
{% endblock %}
