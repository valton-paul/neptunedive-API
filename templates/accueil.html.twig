{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <main>

        {% if sorties is defined %}
            <h1>Les sorties à venir</h1>
            <ul>
                {% for sortie in sorties %}
                    <li>
                        <a href="{{ path('sortie', {'id': sortie.id}) }}">{{ sortie.type }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>Aucune sortie à venir</p>
        {% endif %}

    </main>
{% endblock %}
