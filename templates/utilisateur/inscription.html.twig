{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <main>
        {{ form_start(form) }}
        <fieldset>
            <div>
                <p>Nom : {{ demande.getNom }}</p>
                <p>Prénom : {{ demande.getPrenom }}</p>
                <p>Email : {{ demande.getEmail }}</p>
            </div>

            <div>
                {{ form_label(form.plainPassword) }}
                {{ form_widget(form.plainPassword) }}
            </div>

            {{ form_widget(form.inscription) }}
        </fieldset>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </main>
{% endblock %}
